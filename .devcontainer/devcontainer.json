{
  "name": "Codespace",

  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24.18.0",
      "nodeGypDependencies": true
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },

  "containerEnv": {
    "NODE_VERSION": "24.18.0",
    "PNPM_VERSION": "10.32.0"
  },

  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.32.0 --activate && node --version && pnpm --version && pnpm install && pnpm approve-builds --all && pnpm install --frozen-lockfile",

  "customizations": {
    "vscode": {
      "extensions": [
        "cloudflare.cloudflare-workers-bindings",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
